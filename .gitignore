# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local machine configuration
local.properties
android/local.properties

# Signing keys and credentials
*.jks
*.keystore
key.properties
android/key.properties

# Firebase service account credentials
service-account*.json
*-service-account*.json
*serviceAccount*.json

# Environment variables and secrets
.env
.env.*
!.env.example

# Firebase local cache and debug logs
.firebase/
firebase-debug.log
firebase-debug.*.log

# UsOnMap Firebase configuration (configure separately)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Local backups - do not publish
/backup_before_usonmap_features/

# Local debugging logs
/usonmap-log.txt
/flutter_build_log.txt

# Local notes
/README_ROUTE_ENGLISH_UPDATE.txt

# Generated Android packages
*.apk
*.aab

# Local Dart backup files - do not publish
/lib/*-backup.dart
/lib/*_backup.dart

# Private app configuration - never publish
/lib/private_config.dart
